# ============================================================
# Copia este archivo como .env y completa con TUS valores.
# NUNCA subas tu .env a git (ya está en .gitignore).
# ============================================================
APP_ENV=local
APP_DEBUG=true
BASE_URL=http://localhost/opt
STORE_URL=http://localhost/opt

# ============================================================
# Base de datos
# ============================================================
DB_HOST=localhost
DB_NAME=mi_basedatos
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ============================================================
# SMTP Admin (Gmail) - alta de usuarios y avisos de pedido
# ============================================================
SMTP_ADMIN_HOST=smtp.gmail.com
SMTP_ADMIN_PORT=587
SMTP_ADMIN_USER=tucorreo@gmail.com
SMTP_ADMIN_PASS=CAMBIAME
SMTP_ADMIN_SECURITY=tls
SMTP_ADMIN_FROM_EMAIL=no-reply@tudominio.mx
SMTP_ADMIN_FROM_NAME="Mi Empresa"

# ============================================================
# SMTP Noreply (dominio) - correos de pago SPEI
# ============================================================
SMTP_NOREPLY_HOST=mail.tudominio.mx
SMTP_NOREPLY_PORT=465
SMTP_NOREPLY_USER=no-reply@tudominio.mx
SMTP_NOREPLY_PASS=CAMBIAME
SMTP_NOREPLY_SECURITY=ssl
SMTP_NOREPLY_FROM_EMAIL=no-reply@tudominio.mx
SMTP_NOREPLY_FROM_NAME="MI EMPRESA"

# ============================================================
# OpenPay
# ============================================================
OPENPAY_MERCHANT_ID=mxxxxxxxxxxxxxxxxxx
OPENPAY_PUBLIC_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENPAY_PRIVATE_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENPAY_COUNTRY=MX
OPENPAY_PRODUCTION_MODE=false
OPENPAY_REDIRECT_URL=http://localhost/opt/order.php

# ============================================================
# Google Maps (autocompletado de direcciones en checkout)
# ============================================================
GOOGLE_MAPS_API_KEY=AIzaSyTU_KEY_FALSA